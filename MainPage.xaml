<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App8.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25"
            BackgroundColor="#FAFAFA">


            <Label
                Text="App8"
                FontSize="Large"/>

            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="20">
                <Button
                Text="cosa"
                Clicked="OnClickedRegistrarBook"/>

                <Grid>
                    <Entry
                        x:Name="nombreEntry"
                        Placeholder="Nombre"
                        Grid.Column="0"
                        Grid.Row="0"/>

                    <Entry
                        x:Name="grupoEntry"
                        Placeholder="Grupo"
                        Grid.Column="0"
                        Grid.Row="1"/>

                    <Entry
                        x:Name="rfcEntry"
                        Placeholder="RFC"
                        MaxLength="18"
                        Grid.Column="0"
                        Grid.Row="2"/>

                    <Entry
                        x:Name="phoneEntry"
                        Placeholder="Télefono"
                        Keyboard="Numeric"
                        MaxLength="10"
                        Grid.Column="0"
                        Grid.Row="3"/>


                    <Button
                Text="Guardar"
                Clicked="OnSaveClicked"
                Grid.Column="1"
                Grid.Row="0"/>

                    <Button
                Text="Borrar"
                Clicked="OnDeleteClicked"
                Grid.Column="1"
                Grid.Row="1"/>

                    <Button
                Text="Modificar"
                Clicked="OnChange"
                Grid.Column="1"
                Grid.Row="2"/>
                    <Label
                x:Name="error_Mark"
                Text=""
                Grid.Column="1"
                Grid.Row="3"/>
                </Grid>


                <CollectionView
                    x:Name="BookView"
                    SelectionMode="Multiple"
                    Background="#DDDDDD"
                    Grid.Column="1">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <HorizontalStackLayout Spacing="30">
                                <Grid>
                                </Grid>
                                <Label Text="{Binding IF_book_title}" FontAttributes="Bold"/>
                                <Label Text="{Binding IF_book_title}" FontAttributes="Bold"/>
                            </HorizontalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
