<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App8.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25"
            BackgroundColor="#FAFAFA">


            <Label
                Text="App8"
                FontSize="Large"/>

            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="20">
                <Button
                Text="cosa"
                Clicked="OnClickedRegistrarBook"/>


                <CollectionView
                    x:Name="BookView"
                    SelectionMode="Multiple"
                    Background="#DDDDDD"
                    Grid.Column="1">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <HorizontalStackLayout Spacing="30">
                                <Grid>
                                </Grid>
                                <Label Text="{Binding IF_book_title}" FontAttributes="Bold"/>
                                <Label Text="{Binding IF_book_title}" FontAttributes="Bold"/>
                            </HorizontalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
